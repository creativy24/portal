#!/bin/sh
# AutoLogin System v1.0 - Terminal Menu Interaktif
# Cara pakai: autologin [opsi] atau autologin (menu interaktif)

VERSI="1.0"
SCRIPT_DIR="/usr/lib/autologin"
CONFIG_FILE="/etc/autologin/profiles.json"
STATE_DIR="/tmp/autologin/state"
DEBUG_DIR="/tmp/autologin/debug"
BACKEND_FILE="/usr/lib/autologin/captive-detect/backend_hosts.conf"
PORTAL_FILE="/usr/lib/autologin/captive-detect/portal.json"

# Variabel sesi untuk konfigurasi
CFG_LOGICAL=""
CFG_DEVICE=""
CFG_PORTAL_TYPE=""
CFG_URL=""
CFG_USERNAME=""
CFG_PASSWORD=""
CFG_MAC=""
CFG_PATH=""

# ========== FUNGSI UTILITAS ==========

baca_profil() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "{}"
        return
    fi
    cat "$CONFIG_FILE"
}

dapatkan_profil() {
    profile_id="$1"
    jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$profile_id']" 2>/dev/null
}

cek_daemon() {
    pgrep -f "daemon.sh" > /dev/null && echo "JALAN" || echo "MATI"
}

# ========== MENU UTAMA ==========

menu_utama() {
    while true; do
        clear
        echo "========================================="
        echo "  AutoLogin System v$VERSI"
        echo "  Daemon: $(cek_daemon)"
        echo "========================================="
        echo ""
        echo " 1. Scan interface (cari portal)"
        echo " 2. Pilih interface & konfigurasi"
        echo " 3. Lihat profil tersimpan"
        echo " 4. Edit profil tersimpan"
        echo " 5. Hapus profil"
        echo " 6. Enable/disable profil"
        echo " 7. Login manual"
        echo " 8. Logout interface"
        echo " 9. Lihat status semua profil"
        echo "10. Lihat log real-time"
        echo "11. Restart daemon"
        echo "12. Utilitas (MAC, mwan3, throttle, dll.)"
        echo "13. Backup/restore profil"
        echo "14. About (tentang skrip ini)"
        echo "15. Keluar"
        echo ""
        printf "Pilih menu [1-15]: "
        read pilihan
        case "$pilihan" in
            1) menu_scan ;;
            2) menu_pilih_interface ;;
            3) menu_lihat_profil ;;
            4) menu_edit_profil ;;
            5) menu_hapus_profil ;;
            6) menu_toggle_profil ;;
            7) menu_login_manual ;;
            8) menu_logout ;;
            9) menu_status ;;
            10) menu_log ;;
            11) menu_restart ;;
            12) menu_utilitas ;;
            13) menu_backup ;;
            14) menu_about ;;
            15) echo "Sampai jumpa!"; exit 0 ;;
            *) echo "Pilihan tidak valid."; sleep 1 ;;
        esac
    done
}

# ========== 1. SCAN INTERFACE ==========

menu_scan() {
    clear
    echo "=== SCAN INTERFACE ==="
    echo ""
    echo "Mendeteksi portal di semua interface..."
    echo ""
    hasil=$("$SCRIPT_DIR/common.sh" 2>/dev/null)
    if [ -z "$hasil" ]; then
        echo "Tidak ada interface dengan portal terdeteksi."
    else
        echo "$hasil" | jsonfilter -e '@.interfaces[*]' 2>/dev/null | while read -r line; do
            iface=$(echo "$line" | jsonfilter -e '@.interface' 2>/dev/null)
            dev=$(echo "$line" | jsonfilter -e '@.device' 2>/dev/null)
            ip=$(echo "$line" | jsonfilter -e '@.ip' 2>/dev/null)
            portal=$(echo "$line" | jsonfilter -e '@.portal_type' 2>/dev/null)
            echo "  $iface / $dev | IP: ${ip:-?} | Portal: ${portal:-?}"
        done
    fi
    echo ""
    printf "Tekan Enter untuk kembali..."
    read dummy
}

# ========== 2. PILIH INTERFACE & KONFIGURASI ==========

menu_pilih_interface() {
    clear
    echo "=== PILIH INTERFACE ==="
    echo ""
    echo "Mendeteksi portal..."
    hasil=$("$SCRIPT_DIR/common.sh" 2>/dev/null)
    if [ -z "$hasil" ]; then
        echo "Tidak ada interface dengan portal."
        printf "Tekan Enter..."; read dummy; return
    fi

    i=1
    echo "$hasil" | jsonfilter -e '@.interfaces[*]' 2>/dev/null | while read -r line; do
        iface=$(echo "$line" | jsonfilter -e '@.interface' 2>/dev/null)
        dev=$(echo "$line" | jsonfilter -e '@.device' 2>/dev/null)
        echo " $i. $iface / $dev"
        i=$((i+1))
    done > /tmp/autologin_menu_iface.txt

    cat /tmp/autologin_menu_iface.txt
    echo ""
    printf "Pilih nomor interface (0=batal): "
    read nomor

    if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
        return
    fi

    pilihan=$(sed -n "${nomor}p" /tmp/autologin_menu_iface.txt | awk '{print $2}')
    CFG_LOGICAL=$(echo "$pilihan" | cut -d/ -f1)
    CFG_DEVICE=$(echo "$pilihan" | cut -d/ -f2 | tr -d ' ')

    CFG_PORTAL_TYPE=$(echo "$hasil" | jsonfilter -e "@.interfaces[$((nomor-1))].portal_type" 2>/dev/null)
    CFG_URL=$(echo "$hasil" | jsonfilter -e "@.interfaces[$((nomor-1))].portal_url" 2>/dev/null)
    CFG_MAC=$(echo "$hasil" | jsonfilter -e "@.interfaces[$((nomor-1))].mac" 2>/dev/null)
    CFG_PATH=$(echo "$CFG_URL" | sed 's|^https\?://[^/]\+||' | sed 's|?.*||')

    echo ""
    echo "Interface dipilih: $CFG_LOGICAL / $CFG_DEVICE"
    echo "Portal: $CFG_PORTAL_TYPE"
    echo "URL: $CFG_URL"
    echo "Path: $CFG_PATH"
    echo "MAC: $CFG_MAC"
    printf "Tekan Enter untuk lanjut konfigurasi..."
    read dummy

    menu_konfigurasi
}

menu_konfigurasi() {
    while true; do
        clear
        echo "=== KONFIGURASI INTERFACE ==="
        echo ""
        echo "Interface: $CFG_LOGICAL / $CFG_DEVICE"
        echo "Portal: $CFG_PORTAL_TYPE"
        echo "Path: $CFG_PATH"
        echo ""
        echo " 1. Username : ${CFG_USERNAME:-'(kosong)'}"
        echo " 2. Password : ${CFG_PASSWORD:-'(kosong)'}"
        echo " 3. MAC      : ${CFG_MAC:-'(kosong)'}"
        echo " 4. URL      : ${CFG_URL:-'(kosong)'}"
        echo " 5. Detect URL (restart + scan)"
        echo " 6. Ganti path URL"
        echo " 7. Login sekarang"
        echo " 8. Simpan profil"
        echo " 9. Kembali ke menu utama"
        echo ""
        printf "Pilih [1-9]: "
        read pilihan

        case "$pilihan" in
            1) printf "Username: "; read CFG_USERNAME ;;
            2) printf "Password: "; read CFG_PASSWORD ;;
            3) printf "MAC: "; read CFG_MAC ;;
            4) printf "URL: "; read CFG_URL; CFG_PATH=$(echo "$CFG_URL" | sed 's|^https\?://[^/]\+||' | sed 's|?.*||') ;;
            5) detect_url ;;
            6) ganti_path ;;
            7) login_sekarang ;;
            8) simpan_profil_baru ;;
            9) return ;;
            *) echo "Pilihan tidak valid."; sleep 1 ;;
        esac
    done
}

detect_url() {
    echo ""
    echo "Merestart interface $CFG_LOGICAL..."
    ubus call network.interface."$CFG_LOGICAL" down 2>/dev/null
    sleep 2
    ubus call network.interface."$CFG_LOGICAL" up 2>/dev/null
    echo "Menunggu IP..."
    sleep 3
    echo "Mendeteksi URL portal..."
    hasil=$("$SCRIPT_DIR/common.sh" "$CFG_DEVICE" 2>/dev/null)
    CFG_URL=$(echo "$hasil" | jsonfilter -e "@.interfaces[@.device='$CFG_DEVICE'].portal_url" 2>/dev/null)
    if [ -n "$CFG_URL" ]; then
        CFG_PATH=$(echo "$CFG_URL" | sed 's|^https\?://[^/]\+||' | sed 's|?.*||')
        echo "URL baru: $CFG_URL"
    else
        echo "Gagal mendeteksi URL."
    fi
    printf "Tekan Enter..."; read dummy
}

ganti_path() {
    echo ""
    echo "Path saat ini: $CFG_PATH"
    echo ""
    echo "Path yang tersedia (dari portal.json):"
    if [ -f "$PORTAL_FILE" ]; then
        jsonfilter -i "$PORTAL_FILE" -e '@.patterns[*].path_key' 2>/dev/null | while read -r p; do
            echo "  - $p"
        done
    fi
    echo ""
    printf "Masukkan path baru (contoh: /loginocs/): "
    read path_baru
    if [ -n "$path_baru" ] && [ -n "$CFG_URL" ]; then
        server=$(echo "$CFG_URL" | sed 's|^\(https\?://[^/]\+\)/.*|\1|')
        CFG_URL="${server}${path_baru}?$(echo "$CFG_URL" | sed 's|.*?||')"
        CFG_PATH="$path_baru"
        echo "URL baru: $CFG_URL"
    fi
    printf "Tekan Enter..."; read dummy
}

login_sekarang() {
    echo ""
    if [ -z "$CFG_USERNAME" ] || [ -z "$CFG_PASSWORD" ] || [ -z "$CFG_URL" ]; then
        echo "Username, password, dan URL harus diisi."
        printf "Tekan Enter..."; read dummy
        return
    fi
    echo "Mencoba login ke $CFG_LOGICAL..."

    HANDLER=""
    case "$CFG_PATH" in
        */loginocs/*) HANDLER="wifi_id_classic.sh" ;;
        */loginjs/*|*/login/*) HANDLER="wifi_id_nextjs.sh" ;;
        */wms/*) HANDLER="wms.sh" ;;
    esac

    if [ -n "$HANDLER" ]; then
        payload=$(printf '{"url":"%s","username":"%s","password":"%s","logical":"%s","device":"%s","mac":"%s","portal_type":"%s","login_method":"","sub_method":"","gw_id":"","wlan":"","sessionid":"","ipc":"","handler_script":"%s"}' \
            "$CFG_URL" "$CFG_USERNAME" "$CFG_PASSWORD" "$CFG_LOGICAL" "$CFG_DEVICE" "$CFG_MAC" "$CFG_PORTAL_TYPE" "$HANDLER")
        echo "$payload" | "$SCRIPT_DIR/captive-detect/handlers/$HANDLER" 2>/dev/null
    else
        echo "Tidak dapat menentukan handler untuk path $CFG_PATH"
    fi
    echo ""
    printf "Tekan Enter..."; read dummy
}

simpan_profil_baru() {
    echo ""
    if [ -z "$CFG_USERNAME" ] || [ -z "$CFG_PASSWORD" ] || [ -z "$CFG_URL" ] || [ -z "$CFG_LOGICAL" ]; then
        echo "Data tidak lengkap."
        printf "Tekan Enter..."; read dummy
        return
    fi

    profile_id="${CFG_LOGICAL}_$(echo "$CFG_PORTAL_TYPE" | tr '[:upper:]' '[:lower:]')"
    echo "Menyimpan profil: $profile_id..."

    lua -e '
        local json = require "luci.jsonc"
        local config_file = "'"$CONFIG_FILE"'"
        local data = { profiles = {} }
        local f = io.open(config_file, "r")
        if f then
            local content = f:read("*all")
            f:close()
            if content ~= "" then
                local parsed = json.parse(content)
                if parsed and parsed.profiles then data = parsed end
            end
        end

        local new_profile = {
            id = "'"$profile_id"'",
            enabled = true,
            logical = "'"$CFG_LOGICAL"'",
            device = "'"$CFG_DEVICE"'",
            portal_type = "'"$CFG_PORTAL_TYPE"'",
            username = "'"$CFG_USERNAME"'",
            password = "'"$CFG_PASSWORD"'",
            mac = "'"$CFG_MAC"'",
            url = "'"$CFG_URL"'",
            auto_login_enabled = true,
            auto_reconnect_enabled = true,
            health_check_interval = 10,
            stabilization_delay = 10,
            failure_cooldown = 3,
            max_retry = 3,
            anti_blocking_enabled = true,
            telegram_enabled = false,
            telegram_token = "",
            telegram_chat_id = "",
            login_method = "",
            sub_method = "",
            created_at = os.date("%Y-%m-%dT%H:%M:%SZ", os.time())
        }

        local found = false
        for i, p in ipairs(data.profiles) do
            if p.id == "'"$profile_id"'" then
                new_profile.created_at = p.created_at
                data.profiles[i] = new_profile
                found = true
                break
            end
        end
        if not found then
            table.insert(data.profiles, new_profile)
        end

        local out = io.open(config_file .. ".tmp", "w")
        out:write(json.stringify(data, true))
        out:close()
    ' 2>/dev/null
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE" 2>/dev/null

    echo "Profil disimpan. Restart daemon..."
    /etc/init.d/autologin restart 2>/dev/null
    printf "Tekan Enter..."; read dummy
}

# ========== 3. LIHAT PROFIL ==========

menu_lihat_profil() {
    clear
    echo "=== PROFIL TERSIMPAN ==="
    echo ""
    if [ -f "$CONFIG_FILE" ]; then
        for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
            logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
            device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].device" 2>/dev/null)
            portal=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].portal_type" 2>/dev/null)
            enabled=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].enabled" 2>/dev/null)
            state_file="$STATE_DIR/${pid}.state"
            if [ -f "$state_file" ]; then
                status=$(jsonfilter -i "$state_file" -e '@.status' 2>/dev/null)
            else
                status="-"
            fi
            printf "%-25s %-10s/%-8s %-12s %-5s %s\n" "$pid" "$logical" "$device" "$portal" "$enabled" "$status"
        done
    else
        echo "Belum ada profil tersimpan."
    fi
    echo ""
    printf "Tekan Enter untuk kembali..."
    read dummy
}

# ========== 4. EDIT PROFIL ==========

menu_edit_profil() {
    clear
    echo "=== EDIT PROFIL ==="
    echo ""
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Belum ada profil."
        printf "Tekan Enter..."; read dummy; return
    fi

    echo "Daftar profil:"
    i=1
    for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
        logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
        echo " $i. $pid ($logical)"
        i=$((i+1))
    done
    echo ""
    printf "Pilih nomor profil (0=batal): "
    read nomor

    if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
        return
    fi

    edit_id=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[$((nomor-1))].id" 2>/dev/null)
    profil=$(dapatkan_profil "$edit_id")
    if [ -z "$profil" ]; then
        echo "Profil tidak ditemukan."
        printf "Tekan Enter..."; read dummy; return
    fi

    CFG_LOGICAL=$(echo "$profil" | jsonfilter -e '@.logical' 2>/dev/null)
    CFG_DEVICE=$(echo "$profil" | jsonfilter -e '@.device' 2>/dev/null)
    CFG_PORTAL_TYPE=$(echo "$profil" | jsonfilter -e '@.portal_type' 2>/dev/null)
    CFG_URL=$(echo "$profil" | jsonfilter -e '@.url' 2>/dev/null)
    CFG_USERNAME=$(echo "$profil" | jsonfilter -e '@.username' 2>/dev/null)
    CFG_PASSWORD=$(echo "$profil" | jsonfilter -e '@.password' 2>/dev/null)
    CFG_MAC=$(echo "$profil" | jsonfilter -e '@.mac' 2>/dev/null)
    CFG_PATH=$(echo "$CFG_URL" | sed 's|^https\?://[^/]\+||' | sed 's|?.*||')

    menu_konfigurasi

    echo ""
    printf "Simpan perubahan? (y/n): "
    read simpan
    if [ "$simpan" = "y" ] || [ "$simpan" = "Y" ]; then
        lua -e '
            local json = require "luci.jsonc"
            local f = io.open("'"$CONFIG_FILE"'", "r")
            local data = json.parse(f:read("*all"))
            f:close()
            for _, p in ipairs(data.profiles) do
                if p.id == "'"$edit_id"'" then
                    p.username = "'"$CFG_USERNAME"'"
                    p.password = "'"$CFG_PASSWORD"'"
                    p.mac = "'"$CFG_MAC"'"
                    p.url = "'"$CFG_URL"'"
                end
            end
            local out = io.open("'"$CONFIG_FILE"'.tmp", "w")
            out:write(json.stringify(data, true))
            out:close()
        ' 2>/dev/null
        mv "$CONFIG_FILE.tmp" "$CONFIG_FILE" 2>/dev/null
        echo "Profil diupdate."
    fi
    printf "Tekan Enter..."; read dummy
}

# ========== 5. HAPUS PROFIL ==========

menu_hapus_profil() {
    clear
    echo "=== HAPUS PROFIL ==="
    echo ""
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Belum ada profil."
        printf "Tekan Enter..."; read dummy; return
    fi

    echo "Daftar profil:"
    i=1
    for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
        logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
        device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].device" 2>/dev/null)
        echo " $i. $pid ($logical / $device)"
        i=$((i+1))
    done
    echo ""
    printf "Pilih nomor profil (0=batal): "
    read nomor

    if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
        return
    fi

    hapus_id=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[$((nomor-1))].id" 2>/dev/null)
    logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$hapus_id'].logical" 2>/dev/null)
    device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$hapus_id'].device" 2>/dev/null)

    printf "Yakin hapus $hapus_id? (y/n): "
    read yakin
    if [ "$yakin" = "y" ] || [ "$yakin" = "Y" ]; then
        lua -e '
            local json = require "luci.jsonc"
            local f = io.open("'"$CONFIG_FILE"'", "r")
            local data = json.parse(f:read("*all"))
            f:close()
            local new = {}
            for _, p in ipairs(data.profiles) do
                if p.id ~= "'"$hapus_id"'" then table.insert(new, p) end
            end
            data.profiles = new
            local out = io.open("'"$CONFIG_FILE"'.tmp", "w")
            out:write(json.stringify(data, true))
            out:close()
        ' 2>/dev/null
        mv "$CONFIG_FILE.tmp" "$CONFIG_FILE" 2>/dev/null
        rm -f "$STATE_DIR/${hapus_id}.state"
        rm -f /var/run/autologin_"${hapus_id}".lock
        rm -f /var/run/autologin_antiblocking_"${hapus_id}".lock
        [ -n "$logical" ] && rm -f /tmp/autologin/mwan3_throttle_"$logical"
        [ -n "$device" ] && rm -f "$DEBUG_DIR/${device}.log"
        echo "Profil $hapus_id dihapus."
        /etc/init.d/autologin restart 2>/dev/null
    fi
    printf "Tekan Enter..."; read dummy
}

# ========== 6. ENABLE/DISABLE ==========

menu_toggle_profil() {
    clear
    echo "=== ENABLE/DISABLE PROFIL ==="
    echo ""
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Belum ada profil."
        printf "Tekan Enter..."; read dummy; return
    fi

    echo "Daftar profil:"
    i=1
    for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
        enabled=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].enabled" 2>/dev/null)
        logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
        echo " $i. $pid ($logical) : $enabled"
        i=$((i+1))
    done
    echo ""
    printf "Pilih nomor profil (0=batal): "
    read nomor

    if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
        return
    fi

    tog_id=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[$((nomor-1))].id" 2>/dev/null)
    printf "Enable atau disable? (e/d): "
    read action
    case "$action" in
        e|E) value="true" ;;
        d|D) value="false" ;;
        *) echo "Pilihan tidak valid."; sleep 1; return ;;
    esac
    lua -e '
        local json = require "luci.jsonc"
        local f = io.open("'"$CONFIG_FILE"'", "r")
        local data = json.parse(f:read("*all"))
        f:close()
        for _, p in ipairs(data.profiles) do
            if p.id == "'"$tog_id"'" then p.enabled = ('"$value"' == "true") end
        end
        local out = io.open("'"$CONFIG_FILE"'.tmp", "w")
        out:write(json.stringify(data, true))
        out:close()
    ' 2>/dev/null
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE" 2>/dev/null
    if [ "$value" = "false" ]; then rm -f "$STATE_DIR/${tog_id}.state"; fi
    echo "Status diubah."
    printf "Tekan Enter..."; read dummy
}

# ========== 7. LOGIN MANUAL ==========

menu_login_manual() {
    clear
    echo "=== LOGIN MANUAL ==="
    echo ""
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Belum ada profil."
        printf "Tekan Enter..."; read dummy; return
    fi

    echo "Daftar profil:"
    i=1
    for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
        logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
        state_file="$STATE_DIR/${pid}.state"
        if [ -f "$state_file" ]; then
            status=$(jsonfilter -i "$state_file" -e '@.status' 2>/dev/null)
        else
            status="-"
        fi
        echo " $i. $pid ($logical) - $status"
        i=$((i+1))
    done
    echo ""
    printf "Pilih nomor profil (0=batal): "
    read nomor

    if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
        return
    fi

    login_id=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[$((nomor-1))].id" 2>/dev/null)
    echo "Menjalankan login untuk $login_id..."
    "$SCRIPT_DIR/login_executor.sh" "$login_id"
    echo ""
    printf "Tekan Enter..."; read dummy
}

# ========== 8. LOGOUT ==========

menu_logout() {
    clear
    echo "=== LOGOUT ==="
    echo ""
    echo " 1. Logout profil tertentu"
    echo " 2. Logout semua interface"
    echo " 3. Kembali"
    printf "Pilih: "
    read pilih
    case "$pilih" in
        1)
            echo ""
            if [ ! -f "$CONFIG_FILE" ]; then
                echo "Belum ada profil."
                printf "Tekan Enter..."; read dummy; break
            fi
            echo "Daftar profil:"
            i=1
            for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
                logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
                device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].device" 2>/dev/null)
                state_file="$STATE_DIR/${pid}.state"
                if [ -f "$state_file" ]; then
                    status=$(jsonfilter -i "$state_file" -e '@.status' 2>/dev/null)
                else
                    status="-"
                fi
                echo " $i. $pid ($logical / $device) - $status"
                i=$((i+1))
            done
            echo ""
            printf "Pilih nomor profil (0=batal): "
            read nomor

            if [ "$nomor" = "0" ] || [ -z "$nomor" ]; then
                break
            fi

            logout_id=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[$((nomor-1))].id" 2>/dev/null)
            logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$logout_id'].logical" 2>/dev/null)
            device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$logout_id'].device" 2>/dev/null)
            portal_type=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$logout_id'].portal_type" 2>/dev/null)
            url=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$logout_id'].url" 2>/dev/null)
            mac=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$logout_id'].mac" 2>/dev/null)

            if [ -n "$logical" ]; then
                echo "Logout $logout_id ($logical / $device)..."
                "$SCRIPT_DIR/logout.sh" "${portal_type:-WIFI_ID}" "${url:-}" "$device" "$logical" "${mac:-}"
            else
                echo "Profil tidak ditemukan."
            fi
            ;;
        2)
            echo "Logout semua..."
            for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
                logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
                device=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].device" 2>/dev/null)
                portal_type=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].portal_type" 2>/dev/null)
                url=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].url" 2>/dev/null)
                mac=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].mac" 2>/dev/null)
                "$SCRIPT_DIR/logout.sh" "${portal_type:-WIFI_ID}" "${url:-}" "$device" "$logical" "${mac:-}" 2>/dev/null
            done
            ;;
    esac
    printf "Tekan Enter..."; read dummy
}

# ========== 9. STATUS ==========

menu_status() {
    clear
    echo "=== STATUS PROFIL ==="
    echo ""
    printf "%-25s %-10s %-15s %-10s\n" "ID" "LOGICAL" "STATUS" "RETRY"
    echo "------------------------------------------------------------"
    if [ -f "$CONFIG_FILE" ]; then
        for pid in $(jsonfilter -i "$CONFIG_FILE" -e '@.profiles[*].id' 2>/dev/null); do
            logical=$(jsonfilter -i "$CONFIG_FILE" -e "@.profiles[@.id='$pid'].logical" 2>/dev/null)
            state_file="$STATE_DIR/${pid}.state"
            if [ -f "$state_file" ]; then
                status=$(jsonfilter -i "$state_file" -e '@.status' 2>/dev/null)
                retry=$(jsonfilter -i "$state_file" -e '@.retry_count' 2>/dev/null)
            else
                status="-"
                retry="-"
            fi
            printf "%-25s %-10s %-15s %-10s\n" "$pid" "$logical" "$status" "$retry"
        done
    fi
    echo ""
    echo "Daemon: $(cek_daemon)"
    echo ""
    printf "Tekan Enter..."; read dummy
}

