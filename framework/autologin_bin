# ========== FUNGSI UTILITAS ==========

info_interface() {
    logical="$1"
    device=$(uci -q get network."$logical".device 2>/dev/null)
    [ -z "$device" ] && device="$logical"
    echo "=== INFO: $logical ==="
    echo "Device: $device"
    ip=$(ip -4 addr show dev "$device" 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)
    echo "IP: ${ip:-tidak ada}"
    mac=$(cat /sys/class/net/"$device"/address 2>/dev/null)
    echo "MAC: ${mac:-tidak ada}"
    gw=$(ip route show dev "$device" 2>/dev/null | awk '/default/{print $3; exit}')
    echo "Gateway: ${gw:-tidak ada}"
}

cek_portal() {
    logical="$1"
    device=$(uci -q get network."$logical".device 2>/dev/null)
    [ -z "$device" ] && device="$logical"
    hasil=$("$SCRIPT_DIR/health_check.sh" "$device" 2>/dev/null)
    echo "Status: $hasil"
}

cek_mac_spoof() {
    if [ -f /etc/autologin/mac_spoof.cache ]; then
        cat /etc/autologin/mac_spoof.cache
    elif [ -f /tmp/mac_spoof.cache ]; then
        cat /tmp/mac_spoof.cache
    else
        echo "Cache tidak tersedia."
    fi
}

sync_time() {
    echo "Zona: $(uci -q get system.@system[0].zonename 2>/dev/null)"
    echo "Waktu: $(date)"
    "$SCRIPT_DIR/auto_timezone.sh" &
    ntpd -n -q -p 0.openwrt.pool.ntp.org >/dev/null 2>&1
    echo "Selesai. Waktu: $(date)"
}

tampilkan_debug_device() {
    device="$1"
    [ -f "$DEBUG_DIR/${device}.log" ] && cat "$DEBUG_DIR/${device}.log" || echo "Tidak ditemukan."
}

cek_cookie() {
    logical="$1"
    ls -la /tmp/autologin_cookie_"$logical"_* 2>/dev/null || echo "Tidak ada."
}

cek_lock() {
    echo "=== LOCK ==="
    ls -la /var/run/autologin_*.lock 2>/dev/null || echo "Tidak ada."
}

cek_trigger() {
    echo "=== TRIGGER ==="
    ls -la /tmp/autologin_trigger_* 2>/dev/null || echo "Tidak ada."
}

cek_throttle() {
    echo "=== THROTTLE ==="
    ls -la /tmp/autologin/mwan3_throttle_* 2>/dev/null || echo "Tidak ada."
}

cek_telegram() {
    profile_id="$1"
    echo "=== TELEGRAM: $profile_id ==="
    logread -e autologin | grep -i "telegram_notify" | grep "$profile_id" | tail -5
    echo ""
    echo "Berhasil: $(logread -e autologin | grep -i 'telegram_notify' | grep "$profile_id" | grep -c 'berhasil')"
    echo "Gagal: $(logread -e autologin | grep -i 'telegram_notify' | grep "$profile_id" | grep -c 'Gagal')"
}

backup_profil() {
    backup_file="/etc/autologin/profiles.json.backup.$(date +%Y%m%d_%H%M%S)"
    cp "$CONFIG_FILE" "$backup_file" 2>/dev/null
    [ -f "$backup_file" ] && echo "Backup: $backup_file" || echo "Gagal."
}

restore_profil() {
    backup_file="$1"
    cp "$backup_file" "$CONFIG_FILE" && echo "Direstore. Restart daemon: autologin -r"
}

# ========== MODE CEPAT (PARAMETER) ==========

mode_cepat() {
    case "${1}" in
        -s) menu_status ; exit 0 ;;
        -l) logread -e autologin | tail -30 ; exit 0 ;;
        -f) logread -f -e autologin ; exit 0 ;;
        -p) cat "$CONFIG_FILE" 2>/dev/null ; exit 0 ;;
        -m) mwan3 interfaces 2>/dev/null; echo ""; mwan3 status 2>/dev/null ; exit 0 ;;
        -r) /etc/init.d/autologin restart ; exit 0 ;;
        -k) /etc/init.d/autologin stop ; exit 0 ;;
        -c) rm -f /tmp/autologin/mwan3_throttle_*; echo "OK" ; exit 0 ;;
        -v) echo "AutoLogin System v$VERSI" ; exit 0 ;;
        -h|--help)
            echo "AutoLogin v$VERSI - Menu Interaktif"
            echo "Gunakan tanpa parameter untuk menu interaktif."
            echo "Parameter cepat: -s -l -f -p -m -r -k -c -v -h"
            exit 0
            ;;
        *) menu_utama ;;
    esac
}

# ========== MAIN ==========
if [ $# -gt 0 ]; then
    mode_cepat "$@"
else
    menu_utama
fi